{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "CUSTOM: Scatter plot with 4 annotated quadrants. Dashed median lines divide plot into Small/Large pop vs Low/High JS quadrants. Each dot = SA4 region. Combines population and job seeker data.",
  "config": {
    "background": "#FDFAF2",
    "font": "DM Sans",
    "axis": {
      "labelFont": "DM Sans",
      "labelFontSize": 11,
      "labelColor": "#7A6A52",
      "titleFont": "DM Sans",
      "titleFontSize": 11,
      "titleColor": "#7A6A52",
      "gridColor": "#EAE0CE",
      "gridOpacity": 0.9,
      "domainColor": "#D6CCBA",
      "tickColor": "#D6CCBA"
    },
    "legend": {
      "labelFont": "DM Sans",
      "labelFontSize": 11,
      "labelColor": "#3A2C1C",
      "titleFont": "DM Sans",
      "titleFontSize": 11,
      "titleColor": "#7A6A52"
    },
    "view": {
      "stroke": "transparent"
    }
  },
  "width": "container",
  "height": 390,
  "layer": [
    {
      "data": {
        "values": [
          {
            "x": 350000
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#D6CCBA",
        "strokeDash": [
          6,
          4
        ],
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "y": 200000
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#D6CCBA",
        "strokeDash": [
          6,
          4
        ],
        "strokeWidth": 1.2
      },
      "encoding": {
        "y": {
          "field": "y",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "px": 55000,
            "py": 760000,
            "t": "Small pop \u00b7 High JS"
          },
          {
            "px": 680000,
            "py": 760000,
            "t": "Large pop \u00b7 High JS"
          },
          {
            "px": 55000,
            "py": 30000,
            "t": "Small pop \u00b7 Low JS"
          },
          {
            "px": 680000,
            "py": 30000,
            "t": "Large pop \u00b7 Low JS"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 9.5,
        "fontStyle": "italic",
        "opacity": 0.5
      },
      "encoding": {
        "x": {
          "field": "px",
          "type": "quantitative"
        },
        "y": {
          "field": "py",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        },
        "color": {
          "value": "#7A6A52"
        }
      }
    },
    {
      "data": {
        "url": "../chart_data/sa4_combined.json"
      },
      "mark": {
        "type": "point",
        "filled": true,
        "size": 82,
        "opacity": 0.78
      },
      "encoding": {
        "x": {
          "field": "pop_2025",
          "type": "quantitative",
          "axis": {
            "title": "Population (2025)",
            "format": ",.0s"
          }
        },
        "y": {
          "field": "job_seekers",
          "type": "quantitative",
          "axis": {
            "title": "Job Seekers (March 2026)",
            "format": ",.0s"
          }
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "NSW",
              "VIC",
              "QLD",
              "WA",
              "SA",
              "TAS",
              "ACT",
              "NT"
            ],
            "range": [
              "#C0381A",
              "#1A6850",
              "#D08A0A",
              "#1E4E90",
              "#7A2E88",
              "#188858",
              "#C06810",
              "#882E18"
            ]
          },
          "legend": {
            "title": "State",
            "orient": "right"
          }
        },
        "tooltip": [
          {
            "field": "sa4_name",
            "title": "Region"
          },
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "pop_2025",
            "title": "Population",
            "format": ",.0f"
          },
          {
            "field": "job_seekers",
            "title": "Job Seekers",
            "format": ",.0f"
          },
          {
            "field": "js_per_1000",
            "title": "JS per 1,000"
          }
        ]
      }
    }
  ]
}