{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "CUSTOM: Diverging dot plot. Each dot = one SA4 region. X-axis = deviation of JS/1000 from the national average (530). Derived by subtracting national avg from each region's rate. Red = above avg, teal = below.",
  "config": {
    "background": "#FDFAF2",
    "font": "DM Sans",
    "axis": {
      "labelFont": "DM Sans",
      "labelFontSize": 11,
      "labelColor": "#7A6A52",
      "titleFont": "DM Sans",
      "titleFontSize": 11,
      "titleColor": "#7A6A52",
      "gridColor": "#EAE0CE",
      "gridOpacity": 0.9,
      "domainColor": "#D6CCBA",
      "tickColor": "#D6CCBA"
    },
    "legend": {
      "labelFont": "DM Sans",
      "labelFontSize": 11,
      "labelColor": "#3A2C1C",
      "titleFont": "DM Sans",
      "titleFontSize": 11,
      "titleColor": "#7A6A52"
    },
    "view": {
      "stroke": "transparent"
    }
  },
  "width": "container",
  "height": 360,
  "layer": [
    {
      "data": {
        "values": [
          {
            "x": 0
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#17100A",
        "strokeWidth": 1.5,
        "strokeDash": [
          5,
          4
        ]
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              -140,
              150
            ]
          }
        }
      }
    },
    {
      "data": {
        "url": "../chart_data/sa4_combined.json"
      },
      "mark": {
        "type": "point",
        "filled": true,
        "size": 72,
        "opacity": 0.82
      },
      "encoding": {
        "x": {
          "field": "js_deviation",
          "type": "quantitative",
          "scale": {
            "domain": [
              -140,
              150
            ]
          },
          "axis": {
            "title": "Deviation from national average (job seekers per 1,000 people)"
          }
        },
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": [
            "NSW",
            "VIC",
            "QLD",
            "WA",
            "SA",
            "TAS",
            "ACT",
            "NT"
          ],
          "axis": {
            "title": null,
            "labelFontSize": 11
          }
        },
        "color": {
          "condition": {
            "test": "datum.js_deviation > 0",
            "value": "#C0381A"
          },
          "value": "#1A6850"
        },
        "tooltip": [
          {
            "field": "sa4_name",
            "title": "Region"
          },
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "js_per_1000",
            "title": "JS per 1,000"
          },
          {
            "field": "js_deviation",
            "title": "Deviation from avg"
          },
          {
            "field": "pop_2025",
            "title": "Population",
            "format": ",.0f"
          }
        ]
      }
    }
  ]
}