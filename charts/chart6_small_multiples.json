{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "CUSTOM: 8 faceted area charts (one per state) in a 4-column grid, all sharing the same Y-axis scale for direct comparison.",
  "config": {
    "background": "#FDFAF2",
    "font": "DM Sans",
    "axis": {
      "labelFont": "DM Sans",
      "labelFontSize": 11,
      "labelColor": "#7A6A52",
      "titleFont": "DM Sans",
      "titleFontSize": 11,
      "titleColor": "#7A6A52",
      "gridColor": "#EAE0CE",
      "gridOpacity": 0.9,
      "domainColor": "#D6CCBA",
      "tickColor": "#D6CCBA"
    },
    "legend": {
      "labelFont": "DM Sans",
      "labelFontSize": 11,
      "labelColor": "#3A2C1C",
      "titleFont": "DM Sans",
      "titleFontSize": 11,
      "titleColor": "#7A6A52"
    },
    "view": {
      "stroke": "#D6CCBA"
    },
    "header": {
      "labelFont": "DM Sans",
      "labelFontSize": 12,
      "labelFontWeight": "600",
      "labelColor": "#17100A"
    }
  },
  "data": {
    "url": "../chart_data/state_annual.json"
  },
  "transform": [
    {
      "filter": "datum.year <= 2025"
    }
  ],
  "facet": {
    "field": "state",
    "type": "nominal",
    "columns": 4,
    "header": {
      "title": null
    }
  },
  "spec": {
    "width": 175,
    "height": 90,
    "mark": {
      "type": "area",
      "color": "#1A6850",
      "opacity": 0.15,
      "line": {
        "color": "#1A6850",
        "strokeWidth": 1.8
      }
    },
    "encoding": {
      "x": {
        "field": "year",
        "type": "ordinal",
        "axis": {
          "title": null,
          "labelAngle": -45,
          "labelFontSize": 8.5,
          "values": [
            2015,
            2017,
            2019,
            2021,
            2023,
            2025
          ]
        }
      },
      "y": {
        "field": "job_seekers",
        "type": "quantitative",
        "axis": {
          "title": null,
          "format": ",.0s",
          "labelFontSize": 8.5
        },
        "scale": {
          "zero": true
        }
      },
      "tooltip": [
        {
          "field": "state",
          "title": "State"
        },
        {
          "field": "year",
          "title": "Year"
        },
        {
          "field": "job_seekers",
          "title": "Job Seekers",
          "format": ",.0f"
        }
      ]
    }
  }
}