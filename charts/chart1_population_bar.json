{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Horizontal bar chart \u2014 population by state, June 2025.",
  "config": {
    "background": "#FDFAF2",
    "font": "DM Sans",
    "axis": {
      "labelFont": "DM Sans",
      "labelFontSize": 11,
      "labelColor": "#7A6A52",
      "titleFont": "DM Sans",
      "titleFontSize": 11,
      "titleColor": "#7A6A52",
      "gridColor": "#EAE0CE",
      "gridOpacity": 0.9,
      "domainColor": "#D6CCBA",
      "tickColor": "#D6CCBA"
    },
    "legend": {
      "labelFont": "DM Sans",
      "labelFontSize": 11,
      "labelColor": "#3A2C1C",
      "titleFont": "DM Sans",
      "titleFontSize": 11,
      "titleColor": "#7A6A52"
    },
    "view": {
      "stroke": "transparent"
    }
  },
  "data": {
    "url": "../chart_data/state_population.json"
  },
  "width": "container",
  "height": 240,
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "y": {
      "field": "state",
      "type": "nominal",
      "sort": "-x",
      "axis": {
        "title": null,
        "labelFontSize": 12,
        "labelFontWeight": "500"
      }
    },
    "x": {
      "field": "pop_2025",
      "type": "quantitative",
      "axis": {
        "title": "Population (2025)",
        "format": ",.0f"
      }
    },
    "color": {
      "field": "state",
      "type": "nominal",
      "scale": {
        "domain": [
          "NSW",
          "VIC",
          "QLD",
          "WA",
          "SA",
          "TAS",
          "ACT",
          "NT"
        ],
        "range": [
          "#C0381A",
          "#1A6850",
          "#D08A0A",
          "#1E4E90",
          "#7A2E88",
          "#188858",
          "#C06810",
          "#882E18"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "state",
        "title": "State"
      },
      {
        "field": "pop_2025",
        "title": "Population",
        "format": ",.0f"
      },
      {
        "field": "pop_change_pct",
        "title": "Growth (%)"
      }
    ]
  }
}