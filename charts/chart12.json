{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "#FDFAF2",
    "font": "DM Sans",
    "axis": {
      "labelFont": "DM Sans",
      "labelFontSize": 11,
      "labelColor": "#7A6A52",
      "titleFont": "DM Sans",
      "titleFontSize": 11,
      "titleColor": "#7A6A52",
      "gridColor": "#EAE0CE",
      "gridOpacity": 0.9,
      "domainColor": "#D6CCBA",
      "tickColor": "#D6CCBA"
    },
    "legend": {
      "labelFont": "DM Sans",
      "labelFontSize": 11,
      "labelColor": "#3A2C1C",
      "titleFont": "DM Sans",
      "titleFontSize": 11,
      "titleColor": "#7A6A52"
    },
    "view": {
      "stroke": "transparent"
    }
  },
  "width": "container",
  "height": 380,
  "data": {
    "name": "DB"
  },
  "transform": [
    {
      "fold": [
        "js_per1000_2019",
        "js_per1000_2025"
      ],
      "as": [
        "yr",
        "val"
      ]
    },
    {
      "calculate": "datum.yr==='js_per1000_2019'?'2019':'2025'",
      "as": "year"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "opacity": 0.4
      },
      "encoding": {
        "y": {
          "field": "sa4_name",
          "type": "nominal",
          "sort": {
            "field": "js_per1000_2025",
            "order": "descending"
          },
          "axis": {
            "title": null,
            "labelFontSize": 10.5,
            "labelLimit": 210
          }
        },
        "x": {
          "field": "val",
          "type": "quantitative",
          "axis": {
            "title": "Workers per 1,000 Residents"
          }
        },
        "detail": {
          "field": "sa4_name"
        },
        "color": {
          "value": "#C0381A"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 55,
        "opacity": 0.65
      },
      "transform": [
        {
          "filter": "datum.year==='2019'"
        }
      ],
      "encoding": {
        "y": {
          "field": "sa4_name",
          "type": "nominal",
          "sort": {
            "field": "js_per1000_2025",
            "order": "descending"
          }
        },
        "x": {
          "field": "val",
          "type": "quantitative"
        },
        "color": {
          "value": "#D6CCBA"
        },
        "tooltip": [
          {
            "field": "sa4_name",
            "title": "Region"
          },
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "js_per1000_2019",
            "title": "Workers per 1,000 (2019)"
          },
          {
            "field": "js_per1000_2025",
            "title": "Workers per 1,000 (2025)"
          },
          {
            "field": "change",
            "title": "Change"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 70
      },
      "transform": [
        {
          "filter": "datum.year==='2025'"
        }
      ],
      "encoding": {
        "y": {
          "field": "sa4_name",
          "type": "nominal",
          "sort": {
            "field": "js_per1000_2025",
            "order": "descending"
          }
        },
        "x": {
          "field": "val",
          "type": "quantitative"
        },
        "color": {
          "value": "#C0381A"
        },
        "tooltip": [
          {
            "field": "sa4_name",
            "title": "Region"
          },
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "js_per1000_2019",
            "title": "Workers per 1,000 (2019)"
          },
          {
            "field": "js_per1000_2025",
            "title": "Workers per 1,000 (2025)"
          },
          {
            "field": "change",
            "title": "Change"
          }
        ]
      }
    }
  ],
