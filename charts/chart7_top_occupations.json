{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Horizontal bar chart of the top 15 occupations by job seeker count, March 2026.",
  "config": {
    "background": "#FDFAF2",
    "font": "DM Sans",
    "axis": {
      "labelFont": "DM Sans",
      "labelFontSize": 11,
      "labelColor": "#7A6A52",
      "titleFont": "DM Sans",
      "titleFontSize": 11,
      "titleColor": "#7A6A52",
      "gridColor": "#EAE0CE",
      "gridOpacity": 0.9,
      "domainColor": "#D6CCBA",
      "tickColor": "#D6CCBA"
    },
    "legend": {
      "labelFont": "DM Sans",
      "labelFontSize": 11,
      "labelColor": "#3A2C1C",
      "titleFont": "DM Sans",
      "titleFontSize": 11,
      "titleColor": "#7A6A52"
    },
    "view": {
      "stroke": "transparent"
    }
  },
  "data": {
    "url": "../chart_data/top_occupations.json"
  },
  "width": "container",
  "height": 330,
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3,
    "color": "#D08A0A"
  },
  "encoding": {
    "y": {
      "field": "occupation",
      "type": "nominal",
      "sort": "-x",
      "axis": {
        "title": null,
        "labelLimit": 220,
        "labelFontSize": 10.5
      }
    },
    "x": {
      "field": "job_seekers",
      "type": "quantitative",
      "axis": {
        "title": "Job Seekers (March 2026)",
        "format": ",.0f"
      }
    },
    "tooltip": [
      {
        "field": "occupation",
        "title": "Occupation"
      },
      {
        "field": "job_seekers",
        "title": "Job Seekers",
        "format": ",.0f"
      }
    ]
  }
}